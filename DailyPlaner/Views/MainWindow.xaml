<Window x:Class="DailyPlaner.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Ежедневник" Height="768" Width="1280" WindowStartupLocation="CenterScreen"
        Background="{StaticResource RetroBackgroundBrush}">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="0" Background="{StaticResource RetroSidebarBrush}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Margin="10">
                <TextBlock Text="Ежедневник" FontWeight="Bold" FontSize="14" Foreground="Black" Margin="0,0,0,10"/>
                <Button x:Name="NavOverviewButton" Content="Обзор" Tag="OverviewPage" Click="SidebarNav_Click" Margin="0,0,0,4"/>
                <Button x:Name="NavCalendarButton" Content="Календарь" Tag="CalendarPage" Click="SidebarNav_Click" Margin="0,0,0,4"/>
                <Button x:Name="NavTasksButton" Content="Задачи" Tag="TasksPage" Click="SidebarNav_Click" Margin="0,0,0,4"/>
                <Button x:Name="NavEventsButton" Content="События" Tag="EventsPage" Click="SidebarNav_Click" Margin="0,0,0,4"/>
                <Button x:Name="NavNotesButton" Content="Заметки" Tag="NotesPage" Click="SidebarNav_Click" Margin="0,0,0,4"/>
                <Button x:Name="NavAdminButton" Content="Администрирование" Tag="AdminPage" Click="SidebarNav_Click" Margin="0,0,0,4" Visibility="Collapsed"/>
            </StackPanel>

            <StackPanel Grid.Row="2" Margin="10">
                <Button Content="Проверить напоминания" Command="{Binding TestNotificationCommand}" Margin="0,0,0,6"/>
                <CheckBox x:Name="AutoStartSidebarCheckBox" Content="Автозапуск"
                          Foreground="Black"
                          Checked="AutoStartSidebar_Changed" Unchecked="AutoStartSidebar_Changed" Margin="2,0,0,8"/>
                <Button Content="Выйти" Command="{Binding LogoutCommand}"/>
            </StackPanel>
        </Grid>

        <Grid Grid.Column="1" Margin="12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <DockPanel Grid.Row="0" Margin="0,0,0,10">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Привет, " FontWeight="Bold"/>
                    <TextBlock Text="{Binding CurrentUser.Username}" FontWeight="Bold" Foreground="{StaticResource RetroAccentBrush}"/>
                    <TextBlock Text="!"/>
                </StackPanel>
            </DockPanel>



            <Grid x:Name="OverviewPage" Grid.Row="2" Visibility="Visible">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <DockPanel Grid.Row="0" LastChildFill="False">
                    <TextBlock Text="Обзор" FontWeight="Bold" FontSize="14" VerticalAlignment="Center"/>
                    <Button DockPanel.Dock="Right" Content="Импорт JSON" Command="{Binding ImportFromJsonCommand}" Margin="8,0,0,0" VerticalAlignment="Center"/>
                    <Button DockPanel.Dock="Right" Content="Экспорт JSON" Command="{Binding ExportToJsonCommand}" VerticalAlignment="Center"/>
                </DockPanel>
                <StackPanel Grid.Row="1" Orientation="Horizontal" Background="{StaticResource RetroCardBrush}" Margin="8,8,8,18">
                    <TextBlock Text="Всего задач: " Margin="0,0,4,0"/>
                    <TextBlock Text="{Binding Tasks.Count}" FontWeight="Bold" Margin="0,0,20,0"/>
                    <TextBlock Text="Выполнено задач: " Margin="0,0,4,0"/>
                    <TextBlock Text="{Binding CompletedTasksCount}" FontWeight="Bold" Margin="0,0,20,0"/>
                    <TextBlock Text="Событий: " Margin="0,0,4,0"/>
                    <TextBlock Text="{Binding Events.Count}" FontWeight="Bold" Margin="0,0,20,0"/>
                    <TextBlock Text="Заметок: " Margin="0,0,4,0"/>
                    <TextBlock Text="{Binding Notes.Count}" FontWeight="Bold"/>
                </StackPanel>
                <Grid Grid.Row="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="Ближайшие задачи" FontWeight="Bold" Margin="0,0,0,6"/>
                        <ListView Grid.Row="1" ItemsSource="{Binding UpcomingTasks}" ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,0,0,6">
                                        <TextBlock Text="{Binding Title}" FontWeight="Bold"
                                                   TextDecorations="{Binding IsCompleted, Converter={StaticResource BooleanToTextDecorationConverter}}"/>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding DueDate, StringFormat='dd.MM HH:mm'}" Foreground="{StaticResource RetroMutedBrush}" Margin="0,0,10,0"/>
                                            <TextBlock Text="{Binding Priority}" Foreground="{StaticResource RetroMutedBrush}" Margin="0,0,10,0"/>
                                            <TextBlock Text="{Binding IsCompleted, Converter={StaticResource BooleanToStatusBadgeConverter}}" FontWeight="Bold"/>
                                        </StackPanel>
                                    </StackPanel>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Grid>
                    <Grid Grid.Row="1">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="Ближайшие события" FontWeight="Bold" Margin="0,0,0,6"/>
                        <ListView Grid.Row="1" ItemsSource="{Binding Events}" ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,0,0,6">
                                        <TextBlock Text="{Binding Title}" FontWeight="Bold"
                                                   TextDecorations="{Binding IsCompleted, Converter={StaticResource BooleanToTextDecorationConverter}}"/>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding StartDate, StringFormat='dd.MM HH:mm'}" Foreground="{StaticResource RetroMutedBrush}" Margin="0,0,10,0"/>
                                            <TextBlock Text="{Binding Location}" Foreground="{StaticResource RetroMutedBrush}" Margin="0,0,10,0"/>
                                            <TextBlock Text="{Binding IsCompleted, Converter={StaticResource BooleanToStatusBadgeConverter}, ConverterParameter=event}" FontWeight="Bold"/>
                                        </StackPanel>
                                    </StackPanel>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Grid>
                </Grid>
            </Grid>

            <Grid x:Name="TasksPage" Grid.Row="2" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,8">
                    <Button Content="Новая задача" Command="{Binding AddTaskCommand}" Margin="0,0,8,0"/>
                    <Button Content="Изменить" Command="{Binding EditTaskCommand}" Margin="0,0,8,0"/>
                    <Button Content="Удалить" Command="{Binding DeleteTaskCommand}" CommandParameter="{Binding SelectedItems, ElementName=TasksList}" Margin="0,0,8,0"/>
                    <Button Content="Выполнено" Command="{Binding CompleteTaskCommand}"/>
                </StackPanel>
                <ListView Grid.Row="1" x:Name="TasksList" ItemsSource="{Binding Tasks}" SelectedItem="{Binding SelectedTask}"
                          SelectionMode="Extended" MouseDoubleClick="TasksList_MouseDoubleClick">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="0,0,0,4">
                                <TextBlock Text="{Binding Title}" FontWeight="Bold"
                                           TextDecorations="{Binding IsCompleted, Converter={StaticResource BooleanToTextDecorationConverter}}"/>
                                <TextBlock Text="{Binding Description}" TextWrapping="Wrap" Foreground="{StaticResource RetroMutedBrush}"/>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding DueDate, StringFormat=dd.MM.yyyy}" Margin="0,0,10,0"/>
                                    <TextBlock Text="{Binding Priority}" Margin="0,0,10,0"/>
                                    <TextBlock Text="{Binding IsCompleted, Converter={StaticResource BooleanToStatusBadgeConverter}}"/>
                                </StackPanel>
                            </StackPanel>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>

            <Grid x:Name="EventsPage" Grid.Row="2" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,8">
                    <Button Content="Новое событие" Command="{Binding AddEventCommand}" Margin="0,0,8,0"/>
                    <Button Content="Изменить" Command="{Binding EditEventCommand}" Margin="0,0,8,0"/>
                    <Button Content="Удалить" Command="{Binding DeleteEventCommand}" CommandParameter="{Binding SelectedItems, ElementName=EventsList}" Margin="0,0,8,0"/>
                    <Button Content="Завершить" Command="{Binding CompleteEventCommand}"/>
                </StackPanel>
                <ListView Grid.Row="1" x:Name="EventsList" ItemsSource="{Binding Events}" SelectedItem="{Binding SelectedEvent}"
                          SelectionMode="Extended" MouseDoubleClick="EventsList_MouseDoubleClick">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="0,0,0,4">
                                <TextBlock Text="{Binding Title}" FontWeight="Bold"
                                           TextDecorations="{Binding IsCompleted, Converter={StaticResource BooleanToTextDecorationConverter}}"/>
                                <TextBlock Text="{Binding Description}" TextWrapping="Wrap" Foreground="{StaticResource RetroMutedBrush}"/>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding StartDate, StringFormat='dd.MM HH:mm'}" Margin="0,0,4,0"/>
                                    <TextBlock Text="{Binding EndDate, StringFormat='dd.MM HH:mm'}" Margin="0,0,10,0"/>
                                    <TextBlock Text="{Binding Location}" Margin="0,0,10,0"/>
                                    <TextBlock Text="{Binding IsCompleted, Converter={StaticResource BooleanToStatusBadgeConverter}}"/>
                                </StackPanel>
                            </StackPanel>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>

            <Grid x:Name="NotesPage" Grid.Row="2" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,8">
                    <Button Content="Новая заметка" Command="{Binding AddNoteCommand}" Margin="0,0,8,0"/>
                    <Button Content="Изменить" Command="{Binding EditNoteCommand}" Margin="0,0,8,0"/>
                    <Button Content="Удалить" Command="{Binding DeleteNoteCommand}" CommandParameter="{Binding SelectedItems, ElementName=NotesList}"/>
                </StackPanel>
                <ListView Grid.Row="1" x:Name="NotesList" ItemsSource="{Binding Notes}" SelectedItem="{Binding SelectedNote}"
                          SelectionMode="Extended" MouseDoubleClick="NotesList_MouseDoubleClick">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="0,0,0,4">
                                <TextBlock Text="{Binding Title}" FontWeight="Bold"/>
                                <TextBlock Text="{Binding Content}" TextWrapping="Wrap" Foreground="{StaticResource RetroMutedBrush}"/>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Создано: " Foreground="{StaticResource RetroMutedBrush}"/>
                                    <TextBlock Text="{Binding CreatedDate, StringFormat='dd.MM.yyyy HH:mm'}" Foreground="{StaticResource RetroMutedBrush}"/>
                                </StackPanel>
                            </StackPanel>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>

            <Grid x:Name="AdminPage" Grid.Row="2" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="{Binding AdminStatsHeader}" FontWeight="Bold" FontSize="14" Margin="0,0,0,10"/>
                <Grid Grid.Row="1" Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Orientation="Horizontal">
                        <TextBox Text="{Binding AdminSearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="200"/>
                        <Button Content="Сбросить поиск" Click="AdminClearSearchButton_Click" Margin="6,0,0,0"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <DatePicker x:Name="AdminSearchDatePicker" SelectedDate="{Binding AdminSearchDate, Mode=TwoWay}"
                                    Width="120" Opacity="0" IsHitTestVisible="False"/>
                        <Button x:Name="AdminCalendarToggleButton" Content="Дата" Click="AdminCalendarToggleButton_Click"
                                ToolTip="Выбрать дату регистрации"/>
                        <Button Content="Сбросить дату" Click="AdminClearDateButton_Click" ToolTip="Сбросить дату" Margin="6,0,0,0"/>
                    </StackPanel>
                </Grid>
                <StackPanel Grid.Row="2" Orientation="Horizontal" Background="{StaticResource RetroCardBrush}" Margin="8,8,8,18">
                    <TextBlock Text="Пользователей: " Margin="0,0,4,0"/>
                    <TextBlock Text="{Binding TotalUsers}" FontWeight="Bold" Margin="0,0,12,0"/>
                    <TextBlock Text="Задач: " Margin="0,0,4,0"/>
                    <TextBlock Text="{Binding TotalTasks}" FontWeight="Bold" Margin="0,0,12,0"/>
                    <TextBlock Text="Событий: " Margin="0,0,4,0"/>
                    <TextBlock Text="{Binding TotalEvents}" FontWeight="Bold" Margin="0,0,12,0"/>
                    <TextBlock Text="Заметок: " Margin="0,0,4,0"/>
                    <TextBlock Text="{Binding TotalNotes}" FontWeight="Bold" Margin="0,0,12,0"/>
                    <TextBlock Text="Напоминаний: " Margin="0,0,4,0"/>
                    <TextBlock Text="{Binding TotalReminders}" FontWeight="Bold"/>
                </StackPanel>
                <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,10">
                    <Button Content="Сбросить пароль" Command="{Binding ResetUserPasswordCommand}" Margin="0,0,8,0"/>
                    <Button Content="Удалить пользователя" Command="{Binding DeleteUserCommand}"/>
                </StackPanel>
                <ListView Grid.Row="4" x:Name="AdminUsersList" ItemsSource="{Binding Users}" SelectedItem="{Binding SelectedAdminUser}"
                          SelectionMode="Single" MouseDoubleClick="AdminUsersList_MouseDoubleClick">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="0,0,0,4">
                                <TextBlock Text="{Binding Username}" FontWeight="Bold"/>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Email}" Foreground="{StaticResource RetroMutedBrush}" Margin="0,0,12,0"/>
                                    <TextBlock Text="Регистрация: " Foreground="{StaticResource RetroMutedBrush}" Margin="0,0,4,0"/>
                                    <TextBlock Text="{Binding CreatedAt, StringFormat='dd.MM.yyyy HH:mm'}" Foreground="{StaticResource RetroMutedBrush}"/>
                                </StackPanel>
                            </StackPanel>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>

            <Grid x:Name="CalendarPage" Grid.Row="2" Visibility="Collapsed">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid Grid.Column="0" Margin="0,0,16,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="Календарь" FontWeight="Bold" FontSize="14" Margin="0,0,0,8"/>
                    <Calendar Grid.Row="1" x:Name="MainCalendar" SelectedDate="{Binding SelectedDate, Mode=TwoWay}"
                              SelectedDatesChanged="MainCalendar_SelectedDatesChanged"/>
                    <TextBlock Grid.Row="2" Text="Все события на выбранный день" FontWeight="Bold" Margin="0,10,0,6"/>
                    <ListView Grid.Row="3" x:Name="DayEventsList" MouseDoubleClick="DayItem_MouseDoubleClick" ScrollViewer.VerticalScrollBarVisibility="Auto">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" Margin="4,5" MinHeight="26">
                                    <TextBlock Text="{Binding StartDate, StringFormat='HH:mm'}" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding Title}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
                <Grid Grid.Column="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="{Binding SelectedDate, StringFormat='dddd, dd MMMM yyyy'}" FontWeight="Bold" FontSize="14" Margin="0,0,0,6"/>
                    <ListView Grid.Row="1" x:Name="DayTasksList" MouseDoubleClick="DayItem_MouseDoubleClick" ScrollViewer.VerticalScrollBarVisibility="Auto">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" Margin="4,5" MinHeight="26">
                                    <TextBlock Text="{Binding DueDate, StringFormat='HH:mm'}" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding Title}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</Window>
