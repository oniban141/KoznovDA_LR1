<Window x:Class="DailyPlaner.Views.Dialogs.DetailsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Подробная информация" Height="560" Width="480"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{StaticResource RetroBackgroundBrush}">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock x:Name="KindLabel" Text="Задача"/>
            <TextBlock x:Name="TitleText" Text="Название" FontWeight="Bold" TextWrapping="Wrap"/>
        </StackPanel>
        <StackPanel Grid.Row="1">
            <TextBlock Text="Описание" Margin="0,0,0,4"/>
            <TextBlock x:Name="DescriptionText" Text="—" TextWrapping="Wrap" Margin="0,0,0,14"/>
            <TextBlock x:Name="TimeLabel" Text="Срок" Margin="0,0,0,4"/>
            <TextBlock x:Name="TimeText" Text="—" Margin="0,0,0,14"/>
            <TextBlock x:Name="ExtraLabel" Text="Приоритет" Margin="0,0,0,4"/>
            <TextBlock x:Name="ExtraText" Text="—" Margin="0,0,0,14"/>
            <TextBlock x:Name="StatusLabel" Text="Статус" Margin="0,0,0,4"/>
            <TextBlock x:Name="StatusText" Text="—"/>
        </StackPanel>
        <Button x:Name="CloseButton" Grid.Row="2" Content="Закрыть" Click="Close_Click"
                Width="120" HorizontalAlignment="Right"/>
    </Grid>
</Window>
