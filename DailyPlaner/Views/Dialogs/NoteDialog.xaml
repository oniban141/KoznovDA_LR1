<Window x:Class="DailyPlaner.Views.Dialogs.NoteDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Заметка" Height="460" Width="440"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{StaticResource RetroBackgroundBrush}">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock Grid.Row="0" Text="Название" Margin="0,0,0,4"/>
        <Grid Grid.Row="1">
            <TextBox x:Name="TitleBox" TextChanged="TitleBox_TextChanged"/>
            <TextBlock x:Name="TitleWatermark" Text="Введите название заметки"
                       Foreground="{StaticResource RetroMutedBrush}" Opacity="0.55" Margin="8,0,0,0"
                       VerticalAlignment="Center" IsHitTestVisible="False"/>
        </Grid>
        <TextBlock Grid.Row="2" Text="Содержимое" Margin="0,12,0,4"/>
        <Grid Grid.Row="3">
            <TextBox x:Name="ContentBox" TextWrapping="Wrap" AcceptsReturn="True"
                     VerticalContentAlignment="Top" TextChanged="ContentBox_TextChanged"/>
            <TextBlock x:Name="ContentWatermark" Text="Введите текст заметки"
                       Foreground="{StaticResource RetroMutedBrush}" Opacity="0.55" Margin="8,6,0,0"
                       VerticalAlignment="Top" IsHitTestVisible="False"/>
        </Grid>
        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Content="Отмена" Click="Cancel_Click" Width="100" Margin="0,0,12,0"/>
            <Button Content="Сохранить" Click="Save_Click" Width="110"/>
        </StackPanel>
    </Grid>
</Window>
