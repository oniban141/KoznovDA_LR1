<Page x:Class="DailyPlaner.Views.LoginWindow"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Окно входа">
    <Grid Background="{StaticResource RetroBackgroundBrush}">
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Width="340">
            <TextBlock Text="Ежедневник" FontWeight="Bold" FontSize="16" HorizontalAlignment="Center" Margin="0,0,0,6"/>
            <TextBlock Text="С возвращением!" FontWeight="Bold" FontSize="14" Margin="0,0,0,2"/>
            <TextBlock Text="Войдите, чтобы продолжить" Foreground="{StaticResource RetroMutedBrush}" Margin="0,0,0,16"/>
            <TextBlock Text="Имя пользователя" Margin="0,0,0,4"/>
            <Grid Margin="0,0,0,12">
                <TextBox Text="{Binding Username, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         TextChanged="UsernameBox_TextChanged"/>
                <TextBlock x:Name="UsernameWatermark" Text="Введите имя пользователя"
                           Foreground="{StaticResource RetroMutedBrush}" Opacity="0.55" Margin="8,0,0,0"
                           VerticalAlignment="Center" IsHitTestVisible="False"/>
            </Grid>
            <TextBlock Text="Пароль" Margin="0,0,0,4"/>
            <Grid Margin="0,0,0,16">
                <PasswordBox x:Name="PasswordBox" PasswordChanged="PasswordBox_PasswordChanged"/>
                <TextBlock x:Name="PasswordWatermark" Text="Введите пароль"
                           Foreground="{StaticResource RetroMutedBrush}" Opacity="0.55" Margin="8,0,0,0"
                           VerticalAlignment="Center" IsHitTestVisible="False"/>
            </Grid>
            <Button Content="Войти" Command="{Binding LoginCommand}" Margin="0,0,0,12"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <TextBlock Text="Нет аккаунта?" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <Button Content="Зарегистрироваться" Command="{Binding RegisterCommand}"/>
            </StackPanel>
            <ProgressBar IsIndeterminate="{Binding IsLoading}"
                        Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}"
                        Height="14" Margin="0,16,0,0"/>
        </StackPanel>
    </Grid>
</Page>
