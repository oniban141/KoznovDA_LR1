<Application x:Class="DailyPlaner.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:DailyPlaner.Converters">
    <Application.Resources>
        <ResourceDictionary>
            <SolidColorBrush x:Key="RetroBackgroundBrush" Color="#CFC0A4"/>
            <SolidColorBrush x:Key="RetroCardBrush" Color="#E8DCC3"/>
            <SolidColorBrush x:Key="RetroSidebarBrush" Color="#6E7D5D"/>
            <SolidColorBrush x:Key="RetroAccentBrush" Color="#9C4A3F"/>
            <SolidColorBrush x:Key="RetroAccent2Brush" Color="#B08D2E"/>
            <SolidColorBrush x:Key="RetroTextBrush" Color="#33291F"/>
            <SolidColorBrush x:Key="RetroMutedBrush" Color="#71675A"/>
            <SolidColorBrush x:Key="RetroButtonBrush" Color="#C8C8BE"/>
            <SolidColorBrush x:Key="RetroBorderBrush" Color="#574A38"/>

            <Style TargetType="Window">
                <Setter Property="Background" Value="{StaticResource RetroBackgroundBrush}"/>
                <Setter Property="Foreground" Value="{StaticResource RetroTextBrush}"/>
                <Setter Property="FontFamily" Value="Tahoma"/>
                <Setter Property="FontSize" Value="12"/>
            </Style>
            <Style TargetType="Page">
                <Setter Property="Background" Value="{StaticResource RetroBackgroundBrush}"/>
                <Setter Property="Foreground" Value="{StaticResource RetroTextBrush}"/>
                <Setter Property="FontFamily" Value="Tahoma"/>
                <Setter Property="FontSize" Value="12"/>
            </Style>

            <Style TargetType="Button">
                <Setter Property="Background" Value="{StaticResource RetroButtonBrush}"/>
                <Setter Property="Foreground" Value="Black"/>
                <Setter Property="BorderBrush" Value="{StaticResource RetroBorderBrush}"/>
                <Setter Property="BorderThickness" Value="2"/>
                <Setter Property="FontFamily" Value="Tahoma"/>
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="Padding" Value="10,5"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="#DCD8CC"/>
                    </Trigger>
                    <Trigger Property="IsPressed" Value="True">
                        <Setter Property="Background" Value="#AEAEA2"/>
                    </Trigger>
                </Style.Triggers>
            </Style>

            <Style TargetType="TextBox">
                <Setter Property="Background" Value="{StaticResource RetroCardBrush}"/>
                <Setter Property="Foreground" Value="{StaticResource RetroTextBrush}"/>
                <Setter Property="BorderBrush" Value="{StaticResource RetroBorderBrush}"/>
                <Setter Property="BorderThickness" Value="2"/>
                <Setter Property="FontFamily" Value="Tahoma"/>
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="Padding" Value="4,3"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
            </Style>
            <Style TargetType="PasswordBox">
                <Setter Property="Background" Value="{StaticResource RetroCardBrush}"/>
                <Setter Property="Foreground" Value="{StaticResource RetroTextBrush}"/>
                <Setter Property="BorderBrush" Value="{StaticResource RetroBorderBrush}"/>
                <Setter Property="BorderThickness" Value="2"/>
                <Setter Property="FontFamily" Value="Tahoma"/>
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="Padding" Value="4,3"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
            </Style>
            <Style TargetType="ComboBox">
                <Setter Property="Background" Value="{StaticResource RetroCardBrush}"/>
                <Setter Property="Foreground" Value="{StaticResource RetroTextBrush}"/>
                <Setter Property="BorderBrush" Value="{StaticResource RetroBorderBrush}"/>
                <Setter Property="BorderThickness" Value="2"/>
                <Setter Property="FontFamily" Value="Tahoma"/>
                <Setter Property="FontSize" Value="12"/>
            </Style>
            <Style TargetType="DatePicker">
                <Setter Property="Background" Value="{StaticResource RetroCardBrush}"/>
                <Setter Property="Foreground" Value="{StaticResource RetroTextBrush}"/>
                <Setter Property="BorderBrush" Value="{StaticResource RetroBorderBrush}"/>
                <Setter Property="BorderThickness" Value="2"/>
                <Setter Property="FontFamily" Value="Tahoma"/>
                <Setter Property="FontSize" Value="12"/>
            </Style>
            <Style TargetType="CheckBox">
                <Setter Property="Foreground" Value="{StaticResource RetroTextBrush}"/>
                <Setter Property="FontFamily" Value="Tahoma"/>
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
            </Style>
            <Style TargetType="TextBlock">
                <Setter Property="Foreground" Value="{StaticResource RetroTextBrush}"/>
                <Setter Property="FontFamily" Value="Tahoma"/>
                <Setter Property="FontSize" Value="12"/>
            </Style>
            <Style TargetType="ListView">
                <Setter Property="Background" Value="{StaticResource RetroCardBrush}"/>
                <Setter Property="Foreground" Value="{StaticResource RetroTextBrush}"/>
                <Setter Property="BorderBrush" Value="{StaticResource RetroBorderBrush}"/>
                <Setter Property="BorderThickness" Value="2"/>
                <Setter Property="FontFamily" Value="Tahoma"/>
                <Setter Property="FontSize" Value="12"/>
            </Style>
            <Style TargetType="Calendar">
                <Setter Property="Background" Value="{StaticResource RetroCardBrush}"/>
                <Setter Property="Foreground" Value="{StaticResource RetroTextBrush}"/>
                <Setter Property="BorderBrush" Value="{StaticResource RetroBorderBrush}"/>
                <Setter Property="FontFamily" Value="Tahoma"/>
            </Style>
            <Style TargetType="ProgressBar">
                <Setter Property="Background" Value="{StaticResource RetroCardBrush}"/>
                <Setter Property="Foreground" Value="{StaticResource RetroAccent2Brush}"/>
                <Setter Property="Height" Value="14"/>
                <Setter Property="BorderBrush" Value="{StaticResource RetroBorderBrush}"/>
                <Setter Property="BorderThickness" Value="2"/>
            </Style>

            <converters:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
            <converters:BooleanToTextDecorationConverter x:Key="BooleanToTextDecorationConverter"/>
            <converters:BooleanToStatusBadgeConverter x:Key="BooleanToStatusBadgeConverter"/>
        </ResourceDictionary>
    </Application.Resources>
</Application>
